# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# generated prisma client
/src/generated

# local storage driver (used when R2 is not configured)
/.storage

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# embedded dev postgres data
/.pgdata

# frozen standalone page snapshots
/.preview

# lexicon experiment output
/.lexicon

# quality probe output — renders and clips from a real provider
/.probe

# database dumps from `npm run backup`. Committing one would put every
# customer's row, and the whole credit ledger, into the repository.
/.backups
