# ---------------------------------------------------------------------------
# Arka — environment
# Copy to `.env` and fill in. Only DATABASE_URL and BETTER_AUTH_SECRET are
# required to boot; everything else degrades to a safe local default.
# ---------------------------------------------------------------------------

# Postgres. Neon / Supabase / Railway free tier all work.
DATABASE_URL="postgresql://user:password@host/arka?sslmode=require"

# --- Auth -------------------------------------------------------------------
# openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-32-bytes-of-random"
BETTER_AUTH_URL="https://animearka.com"
NEXT_PUBLIC_APP_URL="https://animearka.com"

# Optional Google OAuth. Omit both and the Google button is hidden.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Comma-separated emails auto-promoted to admin on signup.
ADMIN_EMAILS=""

# Proxies in front of the app, as comma-separated CIDR ranges.
#
# Auth rate limiting buckets by client IP taken from `x-forwarded-for`. Leave
# this empty ONLY if exactly one proxy sets that header (plain Vercel does).
# Add a layer — Cloudflare in front of Vercel — and the header becomes a chain
# no client IP can be trusted from, at which point every visitor shares one
# bucket and sign-in caps at three attempts per ten seconds for the whole site.
# Cloudflare publishes its ranges at https://www.cloudflare.com/ips/
TRUSTED_PROXY_CIDRS=""

# --- Video providers --------------------------------------------------------
# Order matters: the router tries them left to right subject to health/cost.
# "mock" needs no key and returns a sample render — the app is fully usable
# end-to-end without spending a rupee.
VIDEO_PROVIDERS="mock"
FAL_KEY=""
# Optional model overrides. Verify these endpoint ids against fal's catalog
# before going live — vendors rename and retire endpoints.
FAL_PREVIEW_MODEL="fal-ai/wan/v2.6/text-to-video"
FAL_FINAL_MODEL="fal-ai/kling-video/v3/standard/text-to-video"
# Narration. Verify against fal's catalog — TTS endpoints churn faster than
# video ones, especially for Indian-language coverage.
FAL_TTS_MODEL="fal-ai/minimax/speech-02-turbo"

# --- Email (Resend) ---------------------------------------------------------
# Needed for password resets. Without a key, reset links are printed to the
# server console instead of emailed, which is fine locally and loud in prod.
RESEND_API_KEY=""
EMAIL_FROM="Arka <onboarding@resend.dev>"

# --- Storage (Cloudflare R2) ------------------------------------------------
# Leave blank to use the local filesystem driver (writes to ./.storage).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="arka"
# Optional public custom domain for the bucket. Blank => signed URLs only.
R2_PUBLIC_BASE_URL=""

# --- Payments (Razorpay) ----------------------------------------------------
# Leave blank to run billing in test mode: checkout is disabled and the
# pricing page shows a "coming soon" state instead of erroring.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# --- Ops --------------------------------------------------------------------
# Shared secret for /api/cron/* — Vercel Cron sends it as a Bearer token.
CRON_SECRET="replace-me"

# Hard ceiling on provider spend per UTC day, in USD. Jobs defer past it.
DAILY_BUDGET_USD="30"

# How long one queue tick may run before it hands its remaining jobs back.
#
# This has to fit inside the host's function timeout with room to spare, and it
# is what stops an invocation being killed halfway through an encode — with the
# provider already paid and the render lost. The default suits the 60-second
# maxDuration the routes declare, which is the lowest ceiling any Vercel plan
# imposes. On a plan or a host that allows longer, raise both together.
WORKER_TICK_BUDGET_MS="50000"

# Where the external uptime monitor lives. Declarative — nothing reads it at
# runtime; `npm run preflight` fails in production while it is empty.
#
# alerts.ts runs on this app's own cron, so a dead deployment sends no alert:
# the silence looks exactly like health. Point UptimeRobot or BetterStack at
# /api/health and record the dashboard URL here.
EXTERNAL_MONITOR_URL=""

# One line describing how this database is backed up, e.g.
# "Neon PITR 7 days + weekly npm run backup to R2". Also declarative, also
# preflight-gated. credit_ledger is the only record of what customers are owed
# and cannot be rebuilt from any vendor.
BACKUP_POLICY=""

# Where `npm run backup` writes dumps. Defaults to ./.backups
BACKUP_DIR=""

# --- Launch ------------------------------------------------------------------
# "coming-soon" serves only the holding page, the policy pages and
# /api/health. "live" opens the product.
#
# Unset means CLOSED in production and OPEN in development, so a deploy that
# forgets to set anything shows a holding page rather than a signup form backed
# by an unconfigured mailer and a generator with no model behind it. Opening is
# the deliberate act.
NEXT_PUBLIC_LAUNCH_MODE=""

# The one line the holding page promises. A hard-coded "in a week" becomes
# untrue in eight days and then stays on the internet being untrue, so set
# something you will hit or leave it blank for "Opening shortly."
NEXT_PUBLIC_LAUNCH_PROMISE=""

# --- Analytics --------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Anime checkpoint for stage one. Unset = plain SDXL (works, looks generic).
# e.g. an Illustrious or NoobAI repo on HuggingFace.
FAL_STILL_CHECKPOINT=""

# Image-to-video endpoints, used whenever an approved still exists.
FAL_PREVIEW_I2V_MODEL=""
FAL_FINAL_I2V_MODEL=""
