// prisma/schema.prisma
// SQLite-compatible: enums → String, Json → String

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Admin-only account (the site owner). No public signup flow is linked from
// the UI — this exists purely to gate /admin.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
}

// audience values: STUDENT | EARLY_CAREER | FOUNDER | GENERAL (stored as String for SQLite)
// difficulty values: Easy | Medium | Hard
// tags: comma-separated free text, e.g. "remote,paid,ai"
// source values: user-provided | researched
model Opportunity {
  id            String    @id @default(cuid())
  // Human-readable URL segment, e.g. "chevening-scholarship-uk-gov-k2p901".
  // Built from the row's own title/org plus a suffix of its cuid (see
  // lib/slug.ts) — derived from stored facts, never invented. Nullable
  // because it was added to a populated table: rows written before the
  // backfill (scripts/backfill-slugs.ts) legitimately have none, and
  // /opportunities/[id] still resolves those by id and 308s to the slug once
  // one exists. Every write path sets it; a null here means "not backfilled
  // yet", not "this listing has no name".
  slug          String?   @unique
  title         String
  description   String
  url           String
  org           String?
  audience      String
  eligibility   String    @default("")
  prepResources String    @default("")
  difficulty    String    @default("Medium")
  tags          String    @default("")
  location      String?
  region        String    @default("") // North America | South America | Europe | Africa | Asia | Oceania | Remote / Global | "" (unknown)
  country       String    @default("") // best-effort from location text, e.g. "India" — "" if not confidently known
  compType      String?
  // A short, original 1-2 sentence AI-written summary — never a paraphrase
  // instruction that could invent facts, only ever describing what's
  // literally in title/org/description (see lib/scraper/summarize.ai.ts).
  // Exists because `description` itself is usually scraped verbatim from
  // the original posting, identical to what Indeed/LinkedIn/the employer's
  // own site show — real duplicate-content risk that hurts ranking against
  // higher-authority domains carrying the same text. `summary` is the one
  // piece of genuinely original copy on the page. Null until the
  // ingestion-time AI call succeeds or a backfill covers it (see
  // scripts/backfill-summaries.ts) — the raw description is still shown
  // and indexed either way, this only adds to it.
  summary       String?
  // The four fields below feed the JobPosting structured-data block (see
  // jobPostingJsonLd() in app/opportunities/[id]/page.tsx) — every one is
  // null unless the source genuinely provided (addressRegion: derivable
  // from `location` text itself, e.g. a US "City, ST" suffix) or disclosed
  // (employmentType/salary: only ever set from a real source-provided
  // value — see lib/scraper/normalize.ts and lib/scraper/sources/adzuna.ts
  // — never inferred or estimated). No fabricated field is ever written
  // here; a still-null value after ingestion means the source truly
  // doesn't say, and the JSON-LD omits that property rather than guess.
  addressRegion String?
  employmentType String?  // Google's enum: FULL_TIME | PART_TIME | CONTRACTOR | TEMPORARY | INTERN | VOLUNTEER | PER_DIEM | OTHER
  salaryMin     Float?
  salaryMax     Float?
  salaryCurrency String?  // ISO 4217, e.g. "USD" — always set together with salaryMin/salaryMax
  // Real og:image / og:video pulled from the listing's own application
  // page at ingestion time (lib/ogImage.ts) — never stock media. Null for
  // most pre-existing rows until a backfill runs; the card renders
  // text-only when both are null, same as it always has.
  imageUrl      String?
  videoUrl      String?
  // Duplicate-prevention keys — see lib/scraper/dedupe.ts for how each is
  // derived. `urlKey` is the destination URL with tracking parameters
  // stripped and the remaining query sorted; it is UNIQUE, so a regression in
  // the ingestion path fails loudly at the database instead of quietly
  // minting near-duplicate indexable pages for weeks. One Adzuna ad reached
  // 33 live URLs before this existed, because the old check compared the raw
  // url string and Adzuna rotates a tracking token inside it.
  //
  // `contentKey` is a lossy title|org|location fingerprint, indexed but NOT
  // unique and never acted on automatically: measured against this board it
  // would have collapsed 105 rows, most of them genuinely distinct
  // requisitions (several employers post multiple open roles under one title
  // in one city). It feeds the review queue in the weekly SEO cron instead.
  //
  // Both nullable because they were added to a populated table — see
  // scripts/migrate-dedupe-turso.ts, which backfills them and creates the
  // unique index only after collapsing the existing collisions.
  urlKey        String?   @unique
  contentKey    String?
  // Set on the losing row when a duplicate is collapsed; the row is
  // soft-deleted at the same time, so it leaves the sitemap and every listing
  // query. /opportunities/[id] reads this first and 308s to the survivor
  // rather than 404ing, so an already-indexed duplicate consolidates onto the
  // canonical URL instead of just disappearing from the index.
  duplicateOfId String?
  // Link health. The board's whole promise is "verified, no dead links", but
  // nothing ever re-checked a listing after ingestion, so postings stayed up
  // long after the employer took them down — a sampled check found several
  // 404s and a 410 among live listings. app/api/cron/link-health/route.ts
  // re-checks the least-recently-checked listings on a rolling schedule.
  //
  // `deadStrikes` exists because one failed request is not evidence: hosts
  // rate-limit, block datacentre IPs, and time out. Only a repeated, clearly
  // terminal status (404/410) retires a listing, and any inconclusive result
  // (403/429/5xx/timeout) resets the count rather than accumulating toward a
  // deletion. There is deliberately no `validThrough` column: no source this
  // board ingests discloses an application deadline, and inventing one to
  // satisfy a recommended structured-data field would be exactly the
  // fabrication the JobPosting block already refuses to do.
  lastCheckedAt DateTime?
  deadStrikes   Int       @default(0)
  // Application deadline, feeding JobPosting's `validThrough`. Null on most
  // rows and that is correct, not a gap: no feed this board ingests exposes a
  // deadline field, so a value here was read from something the listing itself
  // states — either a future source's structured field (RawListing.
  // deadlineHint) or an explicit phrase in its own description
  // ("Applications close on 15 March 2027"). See lib/scraper/deadline.ts for
  // why bare dates and numeric DD/MM vs MM/DD forms are deliberately refused.
  //
  // Partial coverage is safe: validThrough is a recommended property and
  // Google reads structured data per page, so listings that have it gain the
  // richer result and listings that don't are unaffected. What is not safe is
  // a wrong one — a past validThrough drops a live posting out of Google Jobs
  // entirely — hence the extractor errs to null throughout.
  validThrough  DateTime?
  // "source" (the feed disclosed it) or "description" (parsed from the
  // listing's own text). Kept so a bad extraction rule can be audited and
  // reverted against only the rows it touched, rather than all of them.
  deadlineSource String?
  viewCount     Int       @default(0)
  verified      Boolean   @default(false)
  featured      Boolean   @default(false)
  featuredUntil DateTime? // set only for paid "Featured" upsells — the hourly scrape cron unsets `featured` once this passes
  source        String    @default("user-provided")
  sourceUrl     String?
  // Only set for source: "user-provided" via the free public submission
  // form — kept for admin accountability/abuse-tracking, same pattern as
  // Resource.submitterEmail. Never rendered on any public page.
  submitterEmail String?
  addedAt       DateTime  @default(now())
  deletedAt     DateTime?

  @@index([audience, addedAt])
  @@index([verified])
  @@index([featured])
  @@index([region])
  @@index([contentKey])
  @@index([lastCheckedAt])
}

// plan/subscriptionStatus are only ever written by a verified payment-provider
// webhook (lib/billing) — never trust a client request to set them directly.
model Subscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  // Supabase auth.users.id — set once this subscriber has logged in via the
  // shared identity flow (see lib/subscriberAuth.ts). Null for email-only
  // subscribers who've never logged in (anonymous save/checkout provisioning).
  authUserId   String?  @unique
  subscribedAt DateTime @default(now())

  plan                   String    @default("free") // "free" | "paid"
  paymentProvider        String?                     // "razorpay" — more can be added later (e.g. "paypal")
  paymentSubscriptionId  String?   @unique
  subscriptionStatus     String?                     // provider's own status string, e.g. "active" | "halted" | "cancelled"
  currentPeriodEnd       DateTime?

  // Referral loop: this subscriber's own shareable code, and whose code (if
  // any) they arrived with. Both plain strings, no FK — same loose-coupling
  // style as the rest of this schema (see OpportunitySubmission.opportunityId).
  referralCode String? @unique
  referredBy   String?

  // Free, optional identity verification: proves this subscriber controls
  // the given email address, nothing more — deliberately no domain
  // allowlist (that's an ongoing maintenance cost this doesn't need).
  // institutionEmail is shown as-is on any "Verified" badge, so a reader
  // judges credibility from the domain themselves (e.g. "@berkeley.edu").
  institutionEmail                String?
  institutionVerified             Boolean   @default(false)
  institutionVerifiedAt           DateTime?
  institutionVerifyToken          String?   @unique
  institutionVerifyTokenExpiresAt DateTime?

  // Opts out of the daily digest email only — never deletes the row, since
  // that would also erase billing/referral history for a paid subscriber.
  // Checked by app/api/cron/social-digest before every send.
  unsubscribedFromDigest Boolean @default(false)

  // Auto-suppression from a Resend bounce/complaint webhook (see
  // app/api/webhooks/resend/route.ts) — distinct from unsubscribedFromDigest
  // because *why* mail stopped matters: a voluntary unsubscribe is a
  // preference, a bounce/complaint is a deliverability signal an admin
  // should be able to see and investigate separately. Null = not suppressed.
  emailSuppressedReason String? // "bounced" | "complained"

  @@index([plan])
  @@index([referredBy])
}

// A visitor's bookmarked opportunity. Keyed to the same lightweight
// Subscriber row + cookie session that already exists for free/paid
// browsing — no new account system, per lib/subscriberSession.ts's existing
// low-stakes tradeoff (this data is no more sensitive than early access).
model SavedOpportunity {
  id            String    @id @default(cuid())
  subscriberId  String
  opportunityId String
  savedAt       DateTime  @default(now())
  // Set the first time this subscriber clicks Apply on something they'd
  // already saved (see app/api/opportunities/[id]/view/route.ts) — the one
  // real signal for "did saving something here lead anywhere," not a vanity
  // metric. Null forever for saves that never converted.
  appliedAt     DateTime?
  // ── Outcome ──────────────────────────────────────────────────────────
  // Until this existed the site could not know whether it had ever worked
  // for anybody. viewCount/verified/featured describe the listing; nothing
  // described what happened to the person. "No public success stories" was
  // never a marketing gap — there was no column to put one in, and asking
  // for testimonials after the fact is the least reliable version of a
  // thing you can simply record as it happens.
  //
  // Null for as long as a chase is open, which is most of them most of the
  // time. Only ever written by the person who chased it (see
  // app/api/saved/outcome/route.ts) — never inferred from clicks, never
  // set by a cron.
  outcome       String?   // got_it | rejected | no_response | withdrew
  outcomeAt     DateTime?
  // Their own words, optional, capped at OUTCOME_NOTE_MAX. Only ever shown
  // publicly alongside shareConsent.
  outcomeNote   String?
  // Explicit, per-outcome permission to show this publicly. Defaults to
  // false and is asked for separately from the outcome itself: an outcome
  // is recorded for the person's own tracker first and is not proof until
  // they say it can be. A "got_it" without consent still counts toward the
  // aggregate number, never toward a quotable story.
  shareConsent  Boolean   @default(false)

  @@unique([subscriberId, opportunityId])
  @@index([subscriberId])
  // Powers the public proof surface and the outcome-nudge query without a
  // full scan as the table grows.
  @@index([outcome])
}

// A standing subscription to a collection — "tell me when something new
// lands in Grants for Founders."
//
// The push machinery (lib/push.ts) and the save machinery (SavedOpportunity)
// both already existed; nothing connected either of them to a *standing*
// interest, so the only signal available for matching was the audience of
// things a person had already saved — which pings a student about every new
// student listing on the board. This is the missing half: an explicit,
// revocable statement of what someone wants to hear about.
model CollectionAlert {
  id             String   @id @default(cuid())
  subscriberId   String
  // Matches a slug in lib/collectionDefs.ts. Stored rather than joined —
  // collections are code-defined, not rows.
  collectionSlug String
  createdAt      DateTime @default(now())
  // Last time a push actually went out for this alert, so the throttle is
  // per-alert rather than per-browser — following three collections should
  // not mean two of them go silent for six hours.
  lastNotifiedAt DateTime?

  @@unique([subscriberId, collectionSlug])
  @@index([subscriberId])
  @@index([collectionSlug])
}

// A browser's Web Push subscription — tied to a Subscriber so "matching"
// (lib/push.ts) can compare newly added opportunities against the
// audiences of what that subscriber has saved. lastNotifiedAt throttles
// sends to at most once per window rather than every hourly scrape pass.
model PushSubscription {
  id            String    @id @default(cuid())
  subscriberId  String
  endpoint      String    @unique
  p256dh        String
  auth          String
  createdAt     DateTime  @default(now())
  lastNotifiedAt DateTime?

  @@index([subscriberId])
}

// A paid public submission ("enlist your opportunity"). Nothing here ever
// becomes a live Opportunity on its own — the Razorpay webhook is the only
// thing allowed to flip status to "paid" once payment is actually confirmed,
// and even then the resulting Opportunity is created unverified so it still
// goes through the same human review queue as everything else.
model OpportunitySubmission {
  id               String    @id @default(cuid())
  razorpayOrderId  String    @unique
  status           String    @default("pending") // pending | paid | rejected
  submitterEmail   String
  payload          String    // JSON string of the submitted opportunity fields
  opportunityId    String?   // set once the paid Opportunity row is created
  createdAt        DateTime  @default(now())

  @@index([status])
}

// The front of the sponsorship funnel — a public lead-capture form
// (/advertise), not a checkout. `message` is checked against OpenAI's free
// moderation endpoint (lib/mayatara/moderation.ai.ts) before being stored.
// Admin reviews these by hand and, for real leads, manually creates the
// matching SponsoredSlot row after an off-platform deal — same
// no-self-serve philosophy as SponsoredSlot itself.
model AdInquiry {
  id           String   @id @default(cuid())
  companyName  String
  contactName  String
  contactEmail String
  website      String?
  message      String
  status       String   @default("new") // new | contacted | closed
  createdAt    DateTime @default(now())

  @@index([status])
}

// A manually-booked sponsor line for the daily Telegram/Discord digest —
// "Today's picks, brought to you by X." Deliberately has no payment
// integration: there's no self-serve checkout for this, and none is
// planned until the distribution channels have enough of an audience that
// an advertiser would actually pay for a slot. Whoever runs OppIDX invoices
// a sponsor directly and creates one row here; the digest cron picks up
// whichever row (if any) covers today's date automatically.
model SponsoredSlot {
  id          String   @id @default(cuid())
  sponsorName String
  sponsorUrl  String
  tagline     String   // short line shown alongside the sponsor name, e.g. "Hiring backend engineers"
  // "sidebar" — the homepage sidebar credit line (the original, only
  // placement this model was built for). "feed_card" — a single card
  // rendered near the top of the home board feed, a more prominent
  // placement for a bigger deal. Every placement shares the same
  // date-range visibility and admin book/cancel flow; only where it
  // renders differs.
  type        String   @default("sidebar")
  startDate   DateTime
  endDate     DateTime
  createdAt   DateTime @default(now())

  @@index([startDate, endDate])
}

// audience values: STUDENT | EARLY_CAREER | FOUNDER | GENERAL (stored as String for SQLite)
// category: free text, e.g. "Test Prep" | "Financial Aid" | "Mentorship" | "Templates" | "Courses" | "Communities" | "Tools"
// source values: submitted (passed automated verification, see lib/resources/verify.ts) | admin | scraped
//
// No submission-queue model on purpose — unlike OpportunitySubmission, a
// public resource submission never sits in a human review queue. It either
// passes the automated checks in lib/resources/verify.ts and becomes a live
// (verified) row immediately, or it's rejected outright with a reason and
// nothing is stored. Admin's own recourse is removal after the fact
// (deletedAt), not pre-approval.
model Resource {
  id          String    @id @default(cuid())
  title       String
  description String    @default("")
  url         String
  category    String    @default("General")
  audience    String    @default("GENERAL")
  verified    Boolean   @default(false)
  // Original long-form writing hosted directly on the resource's own detail
  // page (app/resources/[id]) — set only for source: "native" entries. `url`
  // stays required even then, pointed at a further-reading/primary source,
  // since it's the one field every other Resource already relies on.
  body        String    @default("")
  source      String    @default("submitted")
  // Only set for source: "submitted" — the submitter's contact email, kept
  // for admin accountability/abuse-tracking if a listed resource needs to
  // be removed. Never rendered on any public page.
  submitterEmail String?
  addedAt     DateTime  @default(now())
  deletedAt   DateTime?

  @@index([audience, addedAt])
  @@index([verified])
  @@index([category])
}

// One row per resource scraper pass (see lib/resources/scraper) — kept
// separate from ScrapeRun (opportunities) so admin can see each scraper's
// history independently. Same shape on purpose.
model ResourceScrapeRun {
  id         String   @id @default(cuid())
  startedAt  DateTime
  finishedAt DateTime
  added      Int      @default(0)
  details    String   @default("{}")

  @@index([startedAt])
}

// Anonymous, first-party return-visit tracking — the one honest signal
// for "does the same visitor come back on a later day, unprompted"
// (retention, not pageviews). anonId is a random value set in a
// long-lived cookie (see lib/visitTracking.ts), never tied to an email,
// account, or IP — this exists purely to answer one question, not to
// build a profile. One row per (anonId, date): a page load only ever
// upserts, so refreshing 50 times in a day still counts as one visit.
model VisitLog {
  id     String @id @default(cuid())
  anonId String
  date   String // "2026-07-25" (UTC) — only needs day granularity

  @@unique([anonId, date])
  @@index([date])
}

// Weekly snapshot of the Gate-0 retention numbers (see VisitLog) — the
// live admin Stats tab only ever shows the current all-time number, which
// makes "is this actually improving" impossible to answer without
// remembering last week's figure by hand. weekOf: ISO week, e.g.
// "2026-W30", unique. Generated by app/api/cron/retention-snapshot/route.ts.
model RetentionSnapshot {
  id                String   @id @default(cuid())
  weekOf            String   @unique
  totalVisitors     Int
  returningVisitors Int
  returnRatePct     Int
  createdAt         DateTime @default(now())
}

// One row per (subscriber, digest date) actually emailed — durable record
// that does two jobs at once: (1) idempotency, so a same-day cron re-run
// never double-sends to anyone already logged for that date, and (2) a
// place for the Resend webhook (app/api/webhooks/resend/route.ts) to
// update delivery status by resendId, since email_id is the only shared
// key between "we sent this" and "here's what happened to it."
model DigestEmailLog {
  id           String   @id @default(cuid())
  subscriberId String
  date         String
  resendId     String?  @unique
  status       String   @default("sent") // "sent" | "delivered" | "opened" | "clicked" | "bounced" | "complained" | "failed"
  createdAt    DateTime @default(now())

  @@unique([subscriberId, date])
  @@index([date])
}

// A durable, shareable snapshot of one day's "Today's picks from OppIDX"
// social-digest run (see app/api/cron/social-digest/route.ts) — the picks
// themselves are randomly sampled at generation time and never otherwise
// persisted, so this is what a shared /newsletter/[date] link actually
// points to. date: "2026-07-25", unique, doubles as the shareable URL
// slug. opportunityIds: JSON array of picked Opportunity ids, joined live
// at render time (same pattern as SavedOpportunity) so an edited listing
// shows its current details. totalOpportunities/newLast24h are the real
// board counts at generation time — same source as /api/stats, snapshotted
// so they don't silently drift on an old page.
model DailyDigest {
  id                 String   @id @default(cuid())
  date               String   @unique
  opportunityIds     String
  totalOpportunities Int
  newLast24h         Int
  createdAt          DateTime @default(now())

  @@index([createdAt])
}

// A generated, shareable snapshot of Mayatara Pulse content for one day or
// week — see lib/policyDigest/generate.ts. Snapshotted at generation time on
// purpose: pulse_headlines (Supabase) is a rolling 14-day window that
// upserts on url conflict, so a still-current headline's fetched_at keeps
// getting bumped forward — it can't reconstruct "what this looked like on
// a specific past day." A PolicyDigest row is the durable, unchanging
// record a shared link actually points to.
// periodType: "daily" | "weekly". period: "2026-07-24" (daily) or
// "2026-W30" (ISO week, weekly) — unique, doubles as the shareable URL slug.
// items: JSON array of { title, url, category, source, sourceType }.
model PolicyDigest {
  id         String   @id @default(cuid())
  period     String   @unique
  periodType String
  summary    String
  items      String
  createdAt  DateTime @default(now())

  @@index([periodType, createdAt])
}

// One row per native scraper pass (see lib/scraper). `details` is a JSON
// string keyed by source name: { fetched, added, error }.
model ScrapeRun {
  id         String   @id @default(cuid())
  startedAt  DateTime
  finishedAt DateTime
  added      Int      @default(0)
  details    String   @default("{}")

  @@index([startedAt])
}

// The one discussion primitive, attachable to anything in the feed —
// itemType/itemId instead of a relation, same loose-coupling style as
// Subscriber.referredBy: one model instead of a thread table per content
// type. itemType is "opportunity" today; more kinds reuse this as they
// join the feed rather than getting their own comment table.
model Comment {
  id           String    @id @default(cuid())
  itemType     String
  itemId       String
  subscriberId String
  body         String
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  @@index([itemType, itemId, createdAt])
  @@index([subscriberId])
}
